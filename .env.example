# Opervia Environment Configuration
# Copy this file to .env and customize as needed.
#
# Product brand: Opervia. Internal package/binary names (flo-desktop, flocafe)
# are unchanged for upgrade continuity — do not rename them here.

# ── Deploy/start vertical (Phase 3.2) ───────────────────────────────────────
# Selects which Opervia vertical composition mounts at process start.
# NOT runtime-switchable: change this value and restart the app/server.
#
# Valid values:
#   restaurant   — Opervia Restaurant (café/restaurant; includes tables, KDS, addons)
#   retail       — Opervia Retail (production; shared commerce modules only —
#                  no tables, kitchen, KDS, menu, or addons)
#   retail-test  — Synthetic composition for automated validation ONLY.
#                  Do not use for merchants or café pilots.
#
# Safe default for café pilots: leave UNSET (or set restaurant).
# Unset → restaurant. Empty string or unknown id → fail-closed (server refuses to start).
# WARNING: Setting ACTIVE_VERTICAL_ID=retail on a café install disables restaurant
# modules (tables/KDS/addons). Never use retail-test in production.
# ACTIVE_VERTICAL_ID=restaurant

# JWT secret for authentication tokens.
# If not set, Opervia generates a random secret (Electron safeStorage → jwt-secret.enc).
# Prefer leaving unset in packaged apps. Setting JWT_SECRET in production Electron
# requires FLO_ALLOW_JWT_SECRET_ENV=1 (dev/test escape hatch only).
# JWT_SECRET=your-secure-random-string-here

# Allow JWT_SECRET from environment (dev/test only). Do not enable in production cafés.
# FLO_ALLOW_JWT_SECRET_ENV=1

# API server port (default: 3001)
# PORT=3001

# KDS server port (default: 3002)
# KDS_PORT=3002

# Server App / waiter tablet port (default: 3003)
# SERVER_APP_PORT=3003

# Node environment: development, production, test (default: development)
# NODE_ENV=development

# Pino log level (default: debug in development, info in production)
# LOG_LEVEL=info

# Google Drive integration for automated DB backups (#129).
# Both must be set for the "Google Drive" section under Settings >
# Integrations to be usable — if either is missing, the UI shows
# "Google Drive integration is not configured for this build" instead of a
# broken Connect button. See docs/google-drive-setup.md for how to create
# these in Google Cloud Console (APIs & Services > Credentials).
# GOOGLE_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
